{
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@landmarks/*": ["./src/landmarks/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@pages/*": ["./src/pages/*"],
      "@styles/*": ["./src/styles/*"],
      "@utilities/*": ["./src/utilities/*"]
    }
  },
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "./worker-configuration.d.ts"],
  "exclude": ["dist"]
}
