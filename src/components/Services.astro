    title: 'Commercial Ad Production',
    tagline: 'Spots That Sell.',
    description: 'Full-service production for radio, TV, and digital commercials. We write, voice, score, and deliver broadcast-ready spots that cut through the noise and drive results.',
    items: ['30 & 60 Second Radio Spots', 'TV & Digital Commercial Audio', 'Campaign Packages', 'Same-Day Rush Delivery'],
    color: 'purple',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
