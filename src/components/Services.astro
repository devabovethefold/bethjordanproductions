---
const services = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>`,
    title: 'Voiceovers',
    tagline: 'Warm & Conversational.',
    description: 'American female voiceover talent with a warm, relatable delivery. I provide broadcast-quality audio that is clean, clear, and emotionally resonant across all media.',
    items: ['Radio & Podcast Ads', 'E-Learning & Training', 'IVR & Voicemail Messaging', 'Audiobook Narration'],
    color: 'purple',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>`,
    title: 'Audio Ad Production',
    tagline: 'Radio & Podcast.',
    description: 'Full-service production for high-impact advertisements. I turn concepts into polished, broadcast-ready audio that captures attention and drives results.',
    items: ['Radio Spots (30/60s)', 'Podcast Sponsor Reads', 'Brand Imaging', 'Creative Direction'],
    color: 'cyan',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>`,
    title: 'Audio Editing & Sound Design',
    tagline: 'Polished & Professional.',
    description: 'Expert post-production to deliver a seamless, broadcast-quality final product. I handle everything from noise restoration to complex ambient sound design.',
    items: ['Cleanup & Restoration', 'Mixing & Mastering', 'Ambient Sound Design', 'Audiograms'],
    color: 'violet',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m0-12c-1.5 0-3 .5-4.243 1.757A6 6 0 006 12a6 6 0 001.757 4.243M12 18c1.5 0 3-.5 4.243-1.757A6 6 0 0018 12a6 6 0 00-1.757-4.243"/>`,
    title: 'Podcast Editing & Mixing',
    tagline: 'Broadcast Ready.',
    description: 'Turning raw audio into professional, shareable content. Specialized in solo and interview podcasts, including branding and ID3 metadata tagging.',
    items: ['Solo & Interview Editing', 'Branding (Intros/Outros)', 'Audiogram Creation (MP4)', 'ID3 Metadata Tagging'],
    color: 'fuchsia',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>`,
    title: 'Ad Copywriting',
    tagline: 'Compelling & Relatable.',
    description: 'Professional broadcast ad copywriter with a passion for radio and podcast advertising. Custom scripts tailored to match your brand’s unique voice.',
    items: ['Radio Ad Scripts', 'Podcast Sponsor Reads', 'Podcast Intros/Outros', 'Multiple Tone Expertise'],
    color: 'purple',
  },
];

const colorClasses: Record<string, { icon: string; border: string; tag: string; link: string; hover: string }> = {
  purple:  { icon: 'bg-brand-purple/15 border-brand-purple/35 text-brand-purple-light',   border: 'hover:border-brand-purple/30',   tag: 'bg-brand-purple/10 border-brand-purple/25 text-brand-purple-light',   link: 'text-brand-purple-light', hover: 'hover:shadow-brand-purple/10' },
  violet:  { icon: 'bg-violet-500/15 border-violet-500/35 text-violet-300',               border: 'hover:border-violet-500/30',     tag: 'bg-violet-500/10 border-violet-500/25 text-violet-300',               link: 'text-violet-300',         hover: 'hover:shadow-violet-500/10' },
  fuchsia: { icon: 'bg-fuchsia-500/15 border-fuchsia-500/35 text-fuchsia-300',            border: 'hover:border-fuchsia-500/30',   tag: 'bg-fuchsia-500/10 border-fuchsia-500/25 text-fuchsia-300',            link: 'text-fuchsia-300',        hover: 'hover:shadow-fuchsia-500/10' },
  cyan:    { icon: 'bg-brand-cyan/15 border-brand-cyan/35 text-brand-cyan',               border: 'hover:border-brand-cyan/30',     tag: 'bg-brand-cyan/10 border-brand-cyan/25 text-brand-cyan',               link: 'text-brand-cyan',         hover: 'hover:shadow-brand-cyan/10' },
};
---

<section
  id="services"
  class="relative py-24 lg:py-32 bg-mesh-services"
  aria-labelledby="services-heading"
>
  <div class="absolute inset-0 bg-gradient-to-b from-brand-darker to-black pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-purple/15 border border-brand-purple/35 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-purple-light"></span>
        <span class="font-mono text-xs text-brand-purple-light tracking-widest uppercase">What We Do</span>
      </div>
      <h2 id="services-heading" class="font-display text-4xl sm:text-5xl font-bold text-white">
        Complete Audio Solutions. <span class="text-brand-purple-light">One Standard.</span>
      </h2>
      <p class="mt-4 font-body text-white/50 max-w-xl mx-auto">
        Every service delivered with broadcast precision and creative excellence.
      </p>
    </div>

    <!-- Services grid -->
    <div class="flex flex-wrap justify-center gap-6 max-w-6xl mx-auto" role="list">
      {services.map((service) => {
        const c = colorClasses[service.color] ?? colorClasses['purple'];
        return (
          <div
            class={`group rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-sm p-6 ${c.border} transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl ${c.hover} relative overflow-hidden w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]`}
            role="listitem"
          >
            <!-- Top accent on hover -->
            <div class="absolute top-0 left-6 right-6 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent group-hover:via-white/20 transition-colors duration-300" aria-hidden="true"></div>

            <!-- Icon -->
            <div class={`inline-flex items-center justify-center w-11 h-11 rounded-xl border mb-5 ${c.icon}`} aria-hidden="true">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={service.icon}></svg>
            </div>

            <!-- Tagline -->
            <div class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono tracking-widest border mb-3 ${c.tag}`}>
              {service.tagline}
            </div>

            <h3 class="font-display text-xl font-bold text-white mb-3">{service.title}</h3>

            <p class="font-body text-sm text-white/48 leading-relaxed mb-5">{service.description}</p>

            <ul class="space-y-2" aria-label={`${service.title} includes`}>
              {service.items.map((item) => (
                <li class="flex items-center gap-2.5 text-sm text-white/55">
                  <span class={`w-1 h-1 rounded-full shrink-0 ${c.link}`} aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>

            <a
              href="#contact"
              class={`mt-6 inline-flex items-center gap-1.5 text-sm font-medium ${c.link} hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-current rounded`}
              aria-label={`Get a quote for ${service.title}`}
            >
              Get a Quote
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>
