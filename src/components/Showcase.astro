---
import { getTermsForEntries } from 'emdash';
import { getOptimizedImageUrl } from '../utils/media';

interface Post {
  id: string;
  data: {
    id: string;
    title: string;
    excerpt?: string;
    featured_image?: { src?: string };
    media_file?: { id?: string; src?: string; filename?: string; mimeType?: string; size?: number; meta?: { storageKey?: string } };
  };
  publishedAt: Date | null;
}

interface Props {
  posts?: Post[];
}

const { posts = [] } = Astro.props;

// Fetch category terms for all posts
const entryIds = posts.flatMap(p => [p.id, (p.data as any)?.id].filter(Boolean));
const categoriesByEntry = entryIds.length > 0
  ? await getTermsForEntries('posts', entryIds, 'category')
  : new Map();

const labelMap: Record<string, string> = {
  'IVR/On-Hold Messaging': 'IVR & On-Hold',
  'Brand Imaging/Sound Design': 'Imaging & Sound Design',
  'Commercial Ad Production': 'Commercial Ads',
  'Ad Copywriting': 'Ad Copywriting',
  'Copywriting': 'Ad Copywriting',
  'Ad Copy': 'Ad Copywriting',
  'Scripts & Copywriting': 'Ad Copywriting',
  'Scriptwriting': 'Ad Copywriting',
  'Scripts': 'Ad Copywriting',
};

// Category image fallbacks
const categoryImages: Record<string, string> = {
  'Voiceovers': 'https://images.pexels.com/photos/3783471/pexels-photo-3783471.jpeg?auto=compress&cs=tinysrgb&w=600',
  'IVR & On-Hold': '/_emdash/api/media/file/ivr_headset_stock.png?v=3',
  'Audiobooks': 'https://images.pexels.com/photos/3747468/pexels-photo-3747468.jpeg?auto=compress&cs=tinysrgb&w=600',
  'Imaging & Sound Design': 'https://images.pexels.com/photos/257904/pexels-photo-257904.jpeg?auto=compress&cs=tinysrgb&w=600',
  'Commercial Ads': 'https://images.pexels.com/photos/3062541/pexels-photo-3062541.jpeg?auto=compress&cs=tinysrgb&w=600',
  'Podcast Editing': 'https://images.pexels.com/photos/3784221/pexels-photo-3784221.jpeg?auto=compress&cs=tinysrgb&w=600',
  'Music Mixes': 'https://images.pexels.com/photos/164938/pexels-photo-164938.jpeg?auto=compress&cs=tinysrgb&w=600',
  'Ad Copywriting': 'https://images.pexels.com/photos/3059747/pexels-photo-3059747.jpeg?auto=compress&cs=tinysrgb&w=600',
};

function extractPlainText(content: any): string {
  if (!content) return '';
  if (typeof content === 'string') {
    const trimmed = content.trim();
    if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
      try {
        return extractPlainText(JSON.parse(trimmed));
      } catch {
        return content;
      }
    }
    return content;
  }
  if (Array.isArray(content)) {
    return content.map(extractPlainText).filter(Boolean).join('\n');
  }
  if (typeof content === 'object') {
    if (content.text) return content.text;
    if (content.content) return extractPlainText(content.content);
    if (content.children) return extractPlainText(content.children);
    if (content.value) return extractPlainText(content.value);
  }
  return '';
}

const allItems = posts.map((post) => {
  const media = post.data.media_file;
  const isVideo = media?.mimeType?.startsWith('video/') || media?.filename?.endsWith('.mov') || media?.filename?.endsWith('.mp4');
  const isAudio = media?.mimeType?.startsWith('audio/') || media?.filename?.endsWith('.mp3');
  
  const terms = (post as any).terms?.category 
    || (post.data as any)?.terms?.category 
    || categoriesByEntry.get(post.id) 
    || categoriesByEntry.get((post.data as any)?.id) 
    || [];
  const rawCategory = terms[0]?.label || (isVideo ? 'Music Mixes' : 'Voiceovers');
  const category = labelMap[rawCategory] || rawCategory;
  
  const fallbackImage = categoryImages[category] || 'https://images.pexels.com/photos/8867434/pexels-photo-8867434.jpeg?auto=compress&cs=tinysrgb&w=600';

  // Robust featured_image URL extraction
  const rawFeatImg = post.data.featured_image;
  let featImgUrl: string | undefined;
  if (typeof rawFeatImg === 'string') {
    if (rawFeatImg.startsWith('http') || rawFeatImg.startsWith('/')) {
      featImgUrl = rawFeatImg;
    }
  } else if (rawFeatImg && typeof rawFeatImg === 'object') {
    if (typeof rawFeatImg.src === 'string' && (rawFeatImg.src.startsWith('http') || rawFeatImg.src.startsWith('/'))) {
      featImgUrl = rawFeatImg.src;
    } else if (rawFeatImg.meta?.storageKey) {
      featImgUrl = `/_emdash/api/media/file/${rawFeatImg.meta.storageKey}?v=3`;
    }
  }

  // EmDash serves local media files at /_emdash/api/media/file/<storageKey> (public route, no auth).
  // media?.src is only populated for external providers; for local/R2 storage we build the URL from storageKey.
  const storageKey = media?.meta?.storageKey ?? media?.id;
  const mediaSrc = media?.src || (storageKey ? `/_emdash/api/media/file/${storageKey}?v=3` : undefined);

  const rawScript = (post as any).body || (post as any).content || (post.data as any).script || (post.data as any).content || (post.data as any).body || post.data.excerpt || '';
  const scriptText = extractPlainText(rawScript);

  return {
    id: post.id,
    title: post.data.title,
    category: category,
    description: post.data.excerpt || '',
    scriptText: scriptText,
    image: getOptimizedImageUrl(featImgUrl, fallbackImage),
    fallbackImage: fallbackImage,
    client: 'Beth Jordan Productions',
    year: post.publishedAt
      ? new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric' })
      : '',
    featured: Boolean(post.data.featured),
    type: isVideo ? 'video' : isAudio ? 'audio' : 'article',
    audioSrc: isAudio ? mediaSrc : undefined,
    videoSrc: isVideo ? mediaSrc : undefined,
  };
});

// Sort items so featured items appear first
const sortedItems = [...allItems].sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return 0;
});

const categories = [
  'All', 
  'Voiceovers', 
  'IVR & On-Hold', 
  'Audiobooks', 
  'Imaging & Sound Design', 
  'Commercial Ads', 
  'Podcast Editing', 
  'Music Mixes',
  'Ad Copywriting',
];
---

<section
  id="portfolio"
  class="relative py-24 lg:py-32 bg-mesh-portfolio"
  aria-labelledby="portfolio-heading"
>
  <div class="absolute inset-0 bg-gradient-to-b from-brand-darker/90 via-transparent to-brand-darker pointer-events-none" aria-hidden="true"></div>

  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
    x-data="{ 
      activeFilter: 'All', 
      showAll: false, 
      activeScript: null, 
      scriptCopied: false,
      openScriptModal(item) {
        this.activeScript = item;
        this.scriptCopied = false;
        const dialog = document.getElementById('script-dialog');
        if (dialog && typeof dialog.showModal === 'function') {
          dialog.showModal();
        }
      },
      closeScriptModal() {
        const dialog = document.getElementById('script-dialog');
        if (dialog && typeof dialog.close === 'function') {
          dialog.close();
        }
        this.activeScript = null;
      },
      copyScriptText() {
        if (!this.activeScript?.scriptText) return;
        navigator.clipboard.writeText(this.activeScript.scriptText);
        this.scriptCopied = true;
        setTimeout(() => { this.scriptCopied = false; }, 2500);
      }
    }"
  >
    <!-- Section header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-purple/15 border border-brand-purple/35 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
        <span class="font-mono text-xs text-brand-cyan tracking-widest uppercase">Portfolio Showcase</span>
      </div>
      <h2 id="portfolio-heading" class="font-display text-4xl sm:text-5xl font-bold text-white">
        Production Portfolio. <span class="text-brand-purple-light">Hear the Difference.</span>
      </h2>
      <p class="mt-4 font-body text-white/50 max-w-2xl mx-auto">
        Broadcast-quality voiceovers, audiobooks, radio imaging, sound design, and commercial productions. Click play on any audio track or video to preview.
      </p>
    </div>

    <!-- Filter tabs -->
    <div class="flex flex-nowrap overflow-x-auto lg:overflow-x-visible justify-start lg:justify-center gap-1.5 mb-12 pb-2 lg:pb-0 scrollbar-none" role="tablist" aria-label="Filter portfolio by category">
      {categories.map((cat) => (
        <button
          @click={`activeFilter = '${cat}'`}
          :class={`activeFilter === '${cat}' ? 'bg-brand-purple text-white border-brand-purple shadow-lg shadow-brand-purple/25' : 'bg-white/[0.04] text-white/55 border-white/10 hover:bg-white/8 hover:text-white'`}
          class="px-3 py-1.5 rounded-full text-sm font-medium border shrink-0 whitespace-nowrap transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple cursor-pointer"
          role="tab"
          :aria-selected={`activeFilter === '${cat}'`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Tiles grid -->
    <div
      class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6"
      role="tabpanel"
      aria-label="Portfolio items"
    >
      {sortedItems.map((item, i) => (
        <article
          x-data={item.type === 'audio' && item.audioSrc ? `{
            playing: false,
            duration: 0,
            currentTime: 0,
            audio: null,
            formatTime(secs) {
              if (isNaN(secs) || secs === Infinity) return '0:00';
              const m = Math.floor(secs / 60);
              const s = Math.floor(secs % 60);
              return \`\${m}:\${s < 10 ? '0' : ''}\${s}\`;
            },
            init() {
              this.audio = this.$refs.audio;
              this.audio.addEventListener('timeupdate', () => { this.currentTime = this.audio.currentTime; });
              this.audio.addEventListener('loadedmetadata', () => { this.duration = this.audio.duration; });
              this.audio.addEventListener('ended', () => { this.playing = false; this.currentTime = 0; });
            },
            togglePlay() {
              if (this.playing) {
                this.audio.pause();
              } else {
                // Pause all other audio elements on the page first
                document.querySelectorAll('audio').forEach(el => {
                  if (el !== this.audio) {
                    el.pause();
                    // trigger ended or update state if possible
                    el.dispatchEvent(new Event('ended'));
                  }
                });
                this.audio.play().catch(err => console.error('Audio playback failed:', err));
              }
              this.playing = !this.playing;
            },
            seek(e) {
              const rect = e.currentTarget.getBoundingClientRect();
              const clickX = e.clientX - rect.left;
              const width = rect.width;
              const percentage = clickX / width;
              this.audio.currentTime = percentage * this.duration;
            }
          }` : `{}`}
          x-show={`(activeFilter === 'All' && (${i < 9} || showAll)) || activeFilter === '${item.category}'`}
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          @ended.window="if (item.type === 'audio' && $event.target !== $refs.audio) playing = false"
          class="group rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-sm overflow-hidden hover:border-brand-purple/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-brand-purple/10 flex flex-col justify-between"
          aria-label={`${item.title} – ${item.category}`}
        >
          <!-- Image / Video / Audio Trigger area -->
          <div class="relative h-48 overflow-hidden bg-slate-900 flex-shrink-0">
            {item.type === 'audio' && item.audioSrc && (
              <audio x-ref="audio" src={item.audioSrc} preload="none"></audio>
            )}

            {item.type === 'video' && item.videoSrc ? (
              <div x-data="{ showVideo: false }" class="w-full h-full">
                <template x-if="!showVideo">
                  <div class="relative w-full h-full">
                    <img
                      src={item.image}
                      alt={`${item.title} thumbnail`}
                      width="600"
                      height="400"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                      loading={i < 3 ? 'eager' : 'lazy'}
                      fetchpriority={i < 3 ? 'high' : 'auto'}
                      decoding="async"
                      onerror={`this.onerror=null;this.src='${item.fallbackImage}';`}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                    <button
                      @click="showVideo = true"
                      class="absolute inset-0 flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple rounded cursor-pointer"
                      aria-label={`Play video: ${item.title}`}
                    >
                      <div class="w-14 h-14 rounded-full bg-brand-purple/80 backdrop-blur-sm flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-6 h-6 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </div>
                    </button>
                  </div>
                </template>
                <template x-if="showVideo">
                  <div class="relative w-full h-full bg-black">
                    <video controls autoplay class="w-full h-full object-contain">
                      <source src={item.videoSrc} />
                      Your browser does not support the video tag.
                    </video>
                  </div>
                </template>
              </div>
            ) : item.type === 'audio' && item.audioSrc ? (
              <div class="relative w-full h-full">
                <img
                  src={item.image}
                  alt={`${item.title} cover`}
                  width="600"
                  height="400"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={i < 3 ? 'high' : 'auto'}
                  decoding="async"
                  onerror={`this.onerror=null;this.src='${item.fallbackImage}';`}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                
                <!-- Audio Play Button Overlay -->
                <button
                  @click="togglePlay()"
                  class="absolute inset-0 w-full h-full flex items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 focus:outline-none cursor-pointer"
                  aria-label="Play sample"
                >
                  <div class="w-14 h-14 rounded-full bg-brand-cyan/90 flex items-center justify-center shadow-xl transform transition hover:scale-105">
                    <template x-if="!playing">
                      <svg class="w-6 h-6 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </template>
                    <template x-if="playing">
                      <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    </template>
                  </div>
                </button>
                
                <!-- Tiny visualizer bars on image corner when playing -->
                <div x-show="playing" class="absolute bottom-3 right-3 flex items-end gap-0.5 h-6 bg-black/50 px-2 py-1.5 rounded-md backdrop-blur-sm transition-all duration-300">
                  <div class="w-0.5 bg-brand-cyan rounded-full visualizer-bar-1 h-1.5"></div>
                  <div class="w-0.5 bg-brand-cyan rounded-full visualizer-bar-2 h-1.5"></div>
                  <div class="w-0.5 bg-brand-cyan rounded-full visualizer-bar-3 h-1.5"></div>
                </div>
              </div>
            ) : (
              <div
                @click={`openScriptModal(${JSON.stringify(item)})`}
                class="relative w-full h-full cursor-pointer group/tile"
              >
                <img
                  src={item.image}
                  alt={`${item.title} cover`}
                  width="600"
                  height="400"
                  class="w-full h-full object-cover group-hover/tile:scale-105 transition-transform duration-700"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={i < 3 ? 'high' : 'auto'}
                  decoding="async"
                  onerror={`this.onerror=null;this.src='${item.fallbackImage}';`}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-center justify-center">
                  <div class="px-4 py-2 rounded-full bg-brand-purple/90 backdrop-blur-sm text-white font-mono text-xs shadow-lg opacity-0 group-hover/tile:opacity-100 transition-opacity duration-300 flex items-center gap-1.5">
                    <span>Read Script 📄</span>
                  </div>
                </div>
              </div>
            )}

            <!-- Category badge bottom -->
            <div class="absolute bottom-3 left-3 px-2 py-1 rounded-md bg-black/60 backdrop-blur-sm">
              <span class="font-mono text-[9px] text-white/70 tracking-wider uppercase">{item.category}</span>
            </div>
          </div>

          <!-- Content & Local Controls -->
          <div class="p-5 flex-grow flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <h3
                  @click={`openScriptModal(${JSON.stringify(item)})`}
                  class="font-display text-base font-semibold text-white group-hover:text-brand-purple-light transition-colors duration-200 leading-snug cursor-pointer"
                >
                  {item.title}
                </h3>
                {item.year && (
                  <span class="font-mono text-[10px] text-white/25 shrink-0 mt-0.5">{item.year}</span>
                )}
              </div>
              <p class="font-body text-sm text-white/45 leading-relaxed line-clamp-2">
                {item.description}
              </p>
            </div>

            <!-- Audio Player Controls Inside Card -->
            {item.type === 'audio' && item.audioSrc && (
              <div class="mt-4 pt-3 border-t border-white/5 space-y-2">
                <div class="flex items-center gap-3">
                  <!-- Play/Pause small button -->
                  <button 
                    @click="togglePlay()" 
                    class="w-8 h-8 rounded-full bg-gradient-to-r from-brand-purple to-brand-cyan flex items-center justify-center shadow focus:outline-none cursor-pointer transform hover:scale-105 active:scale-95"
                    :aria-label="playing ? 'Pause' : 'Play'"
                  >
                    <template x-if="!playing">
                      <svg class="w-4 h-4 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </template>
                    <template x-if="playing">
                      <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    </template>
                  </button>

                  <!-- Time scrubbing bar -->
                  <div class="flex-grow">
                    <div 
                      @click="seek($event)"
                      class="relative h-1.5 bg-slate-800 rounded-full cursor-pointer hover:h-2 transition-all duration-150 overflow-hidden"
                    >
                      <div 
                        class="absolute top-0 left-0 h-full bg-gradient-to-r from-brand-purple to-brand-cyan rounded-full"
                        :style="'width: ' + (duration ? (currentTime / duration) * 100 : 0) + '%'"
                      ></div>
                    </div>
                  </div>
                </div>

                <!-- Timestamps -->
                <div class="flex justify-between text-[10px] font-mono text-slate-500">
                  <span x-text="formatTime(currentTime)">0:00</span>
                  <span x-text="formatTime(duration)">0:00</span>
                </div>
              </div>
            )}
            
            <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between gap-2">
              <div class="flex items-center gap-1.5">
                <span class="w-1 h-1 rounded-full bg-brand-purple/60" aria-hidden="true"></span>
                <span class="font-mono text-[10px] text-white/35 tracking-wide">{item.client}</span>
              </div>
              <template x-if="item.scriptText">
                <button
                  @click={`openScriptModal(${JSON.stringify(item)})`}
                  class="px-2.5 py-1 rounded-md bg-brand-purple/20 hover:bg-brand-purple/40 text-brand-purple-light text-xs font-mono transition-colors flex items-center gap-1 focus:outline-none cursor-pointer"
                >
                  <span>Read Script</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </button>
              </template>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Native HTML5 Dialog Modal for Script Viewer -->
    <dialog
      id="script-dialog"
      class="fixed inset-0 m-auto rounded-3xl bg-brand-dark/95 border border-white/15 p-0 max-w-2xl w-11/12 shadow-2xl backdrop:backdrop-blur-md backdrop:bg-black/80 text-white overflow-hidden transition-all duration-300"
      @keydown.escape="closeScriptModal()"
    >
      <template x-if="activeScript">
        <div class="p-6 sm:p-8 flex flex-col max-h-[85vh]">
          <!-- Modal Header -->
          <div class="flex items-start justify-between gap-4 pb-4 border-b border-white/10">
            <div>
              <h3 class="font-display text-2xl font-bold text-white leading-tight" x-text="activeScript.title"></h3>
            </div>
            <button
              @click="closeScriptModal()"
              class="w-9 h-9 rounded-full bg-white/5 hover:bg-white/15 border border-white/10 flex items-center justify-center text-white/60 hover:text-white transition-colors focus:outline-none cursor-pointer shrink-0"
              aria-label="Close modal"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>

          <!-- Optional Audio Preview Player Inside Modal -->
          <template x-if="activeScript.audioSrc">
            <div class="my-4 p-4 rounded-xl bg-white/[0.04] border border-white/10 flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-brand-purple/80 flex items-center justify-center text-white shadow-md">
                  <svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
                <div>
                  <div class="text-xs font-medium text-white">Listen to Audio Preview</div>
                  <div class="text-[10px] font-mono text-white/40">Read along with the recorded voiceover</div>
                </div>
              </div>
              <audio controls :src="activeScript.audioSrc" class="h-8 max-w-[200px]" preload="none"></audio>
            </div>
          </template>

          <!-- Teleprompter / Script Content Area -->
          <div class="my-4 flex-grow overflow-y-auto pr-2 space-y-3 font-body text-sm text-white/80 leading-relaxed bg-black/40 p-5 rounded-2xl border border-white/5 max-h-[50vh]">
            <template x-if="activeScript.scriptText">
              <div class="whitespace-pre-line font-mono text-sm leading-relaxed text-white/90" x-text="activeScript.scriptText"></div>
            </template>
          </div>

          <!-- Modal Action Footer -->
          <div class="pt-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-3">
            <button
              @click="copyScriptText()"
              class="px-4 py-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white text-xs font-mono transition-all flex items-center gap-2 border border-white/10 focus:outline-none cursor-pointer"
            >
              <svg class="w-4 h-4 text-brand-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
