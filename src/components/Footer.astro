---
const year = new Date().getFullYear();

const links = {
  Work: [
    { label: 'Portfolio', href: '#portfolio' },
    { label: 'Commercial Ad Production', href: '#services' },
    { label: 'Radio Imaging & Promos', href: '#services' },
    { label: 'Sound Design', href: '#services' },
  ],
  Services: [
    { label: 'Audiobook Production', href: '#services' },
    { label: 'Corporate Audio', href: '#services' },
    { label: 'Music Production', href: '#services' },
    { label: 'Get a Quote', href: '#contact' },
  ],
  Company: [
    { label: 'About', href: '#about' },
    { label: 'Contact', href: '#contact' },
    { label: 'Press', href: '#contact' },
    { label: 'Careers', href: '#contact' },
  ],
};
---

<footer class="relative bg-black border-t border-white/[0.07]" role="contentinfo">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(147,51,234,0.04)_0%,transparent_60%)] pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="pt-16 pb-12 grid lg:grid-cols-5 gap-12">

      <!-- Brand column -->
      <div class="lg:col-span-2 space-y-6">
        <a href="#hero" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple rounded-lg w-fit" aria-label="Beth Jordan Productions – Back to top">
          <div class="w-10 h-10 rounded-xl bg-brand-purple/20 border border-brand-purple/40 flex items-center justify-center">
            <span class="font-display text-sm font-bold text-brand-purple-light">BJP</span>
          </div>
          <div class="leading-tight">
            <div class="font-display text-sm font-bold text-white tracking-wide">Beth Jordan Productions</div>
            <div class="font-mono text-[10px] text-brand-purple-light/60 tracking-widest uppercase">Professional Media Production</div>
          </div>
        </a>

        <p class="font-body text-sm text-white/38 leading-relaxed max-w-xs">
          Broadcast-quality audio production across six disciplines. Your sound, your story, your standard.
        </p>

        <!-- Social links -->
        <div class="flex items-center gap-3">
          {[
            {
              label: 'Facebook',
              href: 'http://www.facebook.com/bethjordanproductions',
              icon: `<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>`,
            },
            {
              label: 'LinkedIn',
              href: 'https://www.linkedin.com/in/bethbier',
              icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
            },
          ].map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-lg bg-white/[0.04] border border-white/10 flex items-center justify-center text-white/35 hover:text-white hover:bg-brand-purple/20 hover:border-brand-purple/30 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple"
              aria-label={social.label}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={social.icon}></svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Nav columns -->
      {Object.entries(links).map(([category, items]) => (
        <nav aria-label={`${category} links`} class="space-y-4">
          <h3 class="font-display text-xs font-semibold text-white/35 uppercase tracking-widest">{category}</h3>
          <ul class="space-y-3">
            {items.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-body text-sm text-white/45 hover:text-white transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple rounded"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/[0.06] py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-body text-xs text-white/22">
        &copy; {year} Beth Jordan Productions. All rights reserved.
      </p>
      <div class="flex items-center gap-5">
        {['Privacy Policy', 'Terms of Service', 'Accessibility'].map((item) => (
          <a
            href="#"
            class="font-body text-xs text-white/22 hover:text-white/50 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple rounded"
          >
            {item}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
